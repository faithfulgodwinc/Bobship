# ════════════════════════════════════════════════════════════════════════════
# BobShip Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# ARCHITECTURE NOTE — How credentials work in BobShip
# ─────────────────────────────────────────────────────
# BobShip is a MULTI-USER tool. Each developer connects THEIR OWN accounts
# through the Settings UI (Google Play, App Store Connect, GitHub, Keystore).
# Those credentials are encrypted and stored per-user in the database.
#
# The variables below are INFRASTRUCTURE-ONLY — they run BobShip itself:
#   • Supabase = the database that stores projects, analyses, credentials
#   • CREDENTIAL_ENCRYPTION_KEY = the key that encrypts stored secrets
#
# Do NOT put your personal Google Play / GitHub credentials here.
# Connect them through the BobShip Settings page instead.
#
# ════════════════════════════════════════════════════════════════════════════

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Your Supabase project URL — safe to expose (used by browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose (browser client, read-only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Supabase service role key — NEVER expose to browser (server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── Credential Encryption Key (required) ────────────────────────────────────
# 32-byte hex key used to AES-256-GCM encrypt all stored user credentials.
# Generate with: openssl rand -hex 32
# NEVER commit this. If it's lost, stored credentials cannot be decrypted.
# Keep a secure backup (e.g. in your password manager).
CREDENTIAL_ENCRYPTION_KEY=

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Single-developer / demo convenience fallbacks
# ════════════════════════════════════════════════════════════════════════════
#
# These are ONLY for running BobShip as a personal tool where you are the only
# user. When set, BobShip uses these as a fallback if no matching credential
# is found in the database for a given project.
#
# For any real deployment (shared team, public product), leave these blank and
# connect credentials through the Settings page instead.
#
# ─────────────────────────────────────────────────────────────────────────────

# Google Play service account JSON (fallback for single-user setups)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Android signing keystore (fallback — base64 encoded .jks file)
# Generate: base64 -i my-keystore.jks | tr -d '\n'
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# GitHub PAT for private repositories (fallback)
GITHUB_PAT=

# App Store Connect API key (fallback — future use)
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY_BASE64=


# ─── AI Metadata Generation ───────────────────────────────────────────────────
# Optional — enables AI-powered store listing copy via GPT-4o-mini.
# Without this key, BobShip uses a smart heuristic engine that already produces
# user-friendly, plain-English copy (no tech jargon). With it, the AI studies
# your app's screens, features and permissions and writes genuinely compelling
# store copy in second-person voice.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to "true" to run the full workflow without making real store submissions.
# Demo mode uses fixture data and clearly labels all demo-only actions.
DEMO_MODE=false
